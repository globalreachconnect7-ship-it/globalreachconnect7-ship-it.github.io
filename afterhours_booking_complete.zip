<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AfterHours Booking</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101010;color:#fff;font-family:Arial,sans-serif}
header{text-align:center;padding:35px 15px;background:#1b1b1b;border-bottom:2px solid #c9a45c}
h1{color:#d8b56d;margin-bottom:8px}
nav{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;padding:18px}
a{color:#e4c27c;text-decoration:none}
.hero{text-align:center;padding:45px 20px}
.hero h2{font-size:30px}
p{line-height:1.6;color:#ddd}
.container{max-width:700px;margin:auto;padding:20px}
.card{background:#202020;border:1px solid #4a3c26;border-radius:12px;padding:20px;margin:15px 0}
.price{color:#e4c27c;font-size:21px;font-weight:bold}
label{display:block;margin-top:15px}
input,select,textarea{width:100%;padding:13px;margin-top:7px;border-radius:6px;border:1px solid #777;background:#111;color:white}
button{width:100%;padding:14px;margin-top:20px;background:#d8b56d;color:#111;border:0;border-radius:6px;font-weight:bold;font-size:16px}
footer{text-align:center;padding:25px;background:#1b1b1b;margin-top:35px}
.small{font-size:13px;color:#aaa}
</style>
</head>
<body>
<header>
<h1>AfterHours Booking</h1>
<p>Premium hospitality and booking experiences</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#rates">Rates</a>
<a href="#vip">VIP Premium</a>
<a href="#booking">Book Now</a>
<a href="#payment">Payment</a>
</nav>

<section class="hero" id="home">
<h2>Welcome to AfterHours</h2>
<p>Choose your booking option, review your price, and submit your request.</p>
<a href="#booking">Make a Booking ↓</a>
</section>

<main class="container">
<section id="rates">
<h2>Booking Rates</h2>
<div class="card">Half-hour <span class="price">$100</span></div>
<div class="card">1 hour <span class="price">$150</span></div>
<div class="card">3 hours — Option 1 <span class="price">$350</span></div>
<div class="card">3 hours — Option 2 <span class="price">$450</span></div>
<div class="card">4 hours <span class="price">$600</span></div>
<div class="card">8 hours <span class="price">$950</span></div>
<div class="card">Overnight <span class="price">$1,500</span></div>
<div class="card">All day <span class="price">$2,500</span></div>
<div class="card">BJ <span class="price">$100</span></div>
</section>

<section id="vip">
<div class="card">
<h2>VIP Premium</h2>
<p>Add VIP Premium to your selected booking for an additional $300.</p>
<p class="small">VIP Premium is an optional booking upgrade, not a group membership.</p>
</div>
</section>

<section id="booking">
<h2>Request a Booking</h2>
<div class="card">
<form id="bookingForm">
<label for="customer">Your name</label>
<input id="customer" required placeholder="Enter your name">

<label for="email">Email address</label>
<input id="email" type="email" required placeholder="Enter your email">

<label for="service">Choose booking option</label>
<select id="service" required>
<option value="100">Half-hour — $100</option>
<option value="150">1 hour — $150</option>
<option value="350">3 hours Option 1 — $350</option>
<option value="450">3 hours Option 2 — $450</option>
<option value="600">4 hours — $600</option>
<option value="950">8 hours — $950</option>
<option value="1500">Overnight — $1,500</option>
<option value="2500">All day — $2,500</option>
<option value="100">BJ — $100</option>
</select>

<label for="vipChoice">VIP Premium upgrade</label>
<select id="vipChoice">
<option value="0">No VIP Premium</option>
<option value="300">Yes, add VIP Premium (+$300)</option>
</select>

<label for="date">Preferred date and time</label>
<input id="date" type="datetime-local" required>

<label for="notes">Additional details</label>
<textarea id="notes" rows="3" placeholder="Add any booking details"></textarea>

<h3>Total: <span id="total">$100</span></h3>
<button type="submit">Prepare Booking Request</button>
</form>
<p class="small">This form prepares a request summary on your device. It does not automatically send a booking to the administrator.</p>
</div>
</section>

<section id="payment">
<div class="card">
<h2>Payment</h2>
<p>Bitcoin Lightning payment address:</p>
<input readonly value="cookedivory24@walletofsatoshi.com" id="lightning">
<button type="button" onclick="copyAddress()">Copy Lightning Address</button>
<p class="small">Only pay after confirming the booking details and total. Payment is not automatically verified by this demo website.</p>
</div>
</section>

<section>
<div class="card">
<h2>Important Information</h2>
<p>Submitting a booking request does not confirm a reservation. Wait for confirmation from the booking administrator.</p>
<p>Contact information and a secure payment verification service must be configured before launch.</p>
</div>
</section>
</main>

<footer>
<p>© 2026 AfterHours Booking</p>
<p class="small">Booking requests are subject to confirmation.</p>
</footer>

<script>
const service = document.getElementById('service');
const vipChoice = document.getElementById('vipChoice');
const total = document.getElementById('total');

function updateTotal(){
  total.textContent = '$' + (Number(service.value) + Number(vipChoice.value)).toLocaleString('en-US');
}
service.addEventListener('change', updateTotal);
vipChoice.addEventListener('change', updateTotal);
updateTotal();

function copyAddress(){
  const address = document.getElementById('lightning');
  address.select();
  address.setSelectionRange(0, 99999);
  if(navigator.clipboard && window.isSecureContext){
    navigator.clipboard.writeText(address.value)
      .then(()=>alert('Lightning address copied'))
      .catch(()=>alert('Please copy the address manually'));
  } else {
    try{
      document.execCommand('copy');
      alert('Lightning address copied');
    }catch(e){
      alert('Please copy the address manually');
    }
  }
}

document.getElementById('bookingForm').addEventListener('submit', function(e){
  e.preventDefault();
  const name = document.getElementById('customer').value;
  const email = document.getElementById('email').value;
  const date = document.getElementById('date').value;
  const notes = document.getElementById('notes').value;
  const vip = Number(vipChoice.value) > 0 ? 'Yes' : 'No';
  const amount = Number(service.value) + Number(vipChoice.value);

  const summary =
    'AFTERHOURS BOOKING REQUEST\n\n' +
    'Name: ' + name + '\n' +
    'Email: ' + email + '\n' +
    'Booking: ' + service.options[service.selectedIndex].text + '\n' +
    'VIP Premium: ' + vip + '\n' +
    'Preferred date/time: ' + date + '\n' +
    'Notes: ' + notes + '\n' +
    'Total: $' + amount.toLocaleString('en-US') + '\n' +
    'Lightning address: cookedivory24@walletofsatoshi.com\n\n' +
    'This is a request only, not a confirmed booking.';

  const file = new Blob([summary], {type:'text/plain'});
  const url = URL.createObjectURL(file);
  const link = document.createElement('a');
  link.href = url;
  link.download = 'afterhours-booking-request.txt';
  link.click();
  URL.revokeObjectURL(url);
  alert('Your booking request summary has been downloaded. It has not been sent to the administrator.');
});
</script>
</body>
</html>
